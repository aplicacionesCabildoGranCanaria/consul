  # secret_key_base: ""
  server_name: ""
  # time_zone: ""
  # mailer_delivery_method: :smtp
  # smtp_settings:
  #   :address: "smtp.example.com"
  #   :port: 25
  #   :domain: "your_domain.com"
  #   :user_name: "<username>"
  #   :password: "<password>"
  #   :authentication: "plain"
  #   :enable_starttls_auto: true
  force_ssl: true
  delay_jobs: true
  email_interceptor_recipients: ""
  errbit_host: ""
  errbit_project_key: ""
  errbit_project_id: 1
  errbit_self_hosted_ssl: false
  http_basic_username: ""
  http_basic_password: ""
  authentication_logs: false
  devise_lockable: false
  managers_url: ""
  managers_application_key: ""
  multitenancy: false
  multitenancy_management_mode: false
  security:
    # allowed_admin_ips: ["123.45.67.89", "192.168.1.0/24"]
    last_sign_in: false
    password_complexity: false
    # lockable:
      # maximum_attempts: 20
      # unlock_in: 1 # In hours
  tenants:
    # If you've enabled multitenancy, you can overwrite secrets for a
    # specific tenant with:
    #
    # my_tenant_subdomain:
    #   secret_key: my_secret_value
    #
    # Currently you can overwrite SMTP, SMS, manager, microsoft API,
    # HTTP basic, twitter, facebook, google, wordpress, SAML and security settings.
  twitter_key: ""
  twitter_secret: ""
  facebook_key: ""
  facebook_secret: ""
  google_oauth2_key: ""
  google_oauth2_secret: ""
  wordpress_oauth2_key: ""
  wordpress_oauth2_secret: ""
  wordpress_oauth2_site: ""
  saml_sp_entity_id: ""
  saml_idp_metadata_url: ""
  saml_idp_sso_service_url: ""
  oidc_client_id: ""
  oidc_client_secret: ""
  oidc_issuer: ""
  <<: *maps
  <<: *apis

production:
  secret_key_base: <%= ENV["SECRET_KEY_BASE"].presence %>
  server_name: <%= ENV["SERVER_NAME"].presence %>
  # time_zone: ""
  mailer_delivery_method: :smtp
  smtp_settings:
    :address: <%= ENV["SMTP_SETTINGS_ADDRESS"].presence %>
    :port: <%= ENV["SMTP_SETTINGS_PORT"].presence %>
    :domain: <%= ENV["SMTP_SETTINGS_DOMAIN"].presence %>
    :user_name: <%= ENV["SMTP_SETTINGS_USER_NAME"].presence %>
    :password: <%= ENV["SMTP_SETTINGS_PASSWORD"].presence %>
    :authentication: "plain"
    :enable_starttls_auto: true
  force_ssl: true
  delay_jobs: true
  errbit_host: ""
  errbit_project_key: ""
  errbit_project_id: 1
  errbit_self_hosted_ssl: false
  http_basic_username: ""
  http_basic_password: ""
  authentication_logs: false
  devise_lockable: false
  managers_url: ""
  managers_application_key: ""
  multitenancy: false
  multitenancy_management_mode: false
  security:
    # allowed_admin_ips: ["123.45.67.89", "192.168.1.0/24"]
    last_sign_in: false
    password_complexity: false
    # lockable:
      # maximum_attempts: 20
      # unlock_in: 1 # In hours
  tenants:
    # If you've enabled multitenancy, you can overwrite secrets for a
    # specific tenant with:
    #
    # my_tenant_subdomain:
    #   secret_key: my_secret_value
    #
    # Currently you can overwrite SMTP, SMS, manager, microsoft API,
    # HTTP basic, twitter, facebook, google, wordpress, SAML and security settings.
  twitter_key: <%= ENV["TWITTER_KEY"].presence %>
  twitter_secret: <%= ENV["TWITTER_SECRET"].presence %>
  facebook_key: <%= ENV["FACEBOOK_KEY"].presence %>
  facebook_secret: <%= ENV["FACEBOOK_SECRET"].presence %>
  google_oauth2_key: <%= ENV["GOOGLE_OAUTH2_KEY"].presence %>
  google_oauth2_secret: <%= ENV["GOOGLE_OAUTH2_SECRET"].presence %>
  wordpress_oauth2_key: <%= ENV["WORDPRESS_OAUTH2_KEY"].presence %>
  wordpress_oauth2_secret: <%= ENV["WORDPRESS_OAUTH2_SECRET"].presence %>
  wordpress_oauth2_site: <%= ENV["WORDPRESS_OAUTH2_SITE"].presence %>
  saml_sp_entity_id: <%= ENV["SAML_SP_ENTITY_ID"].presence %>
  saml_idp_metadata_url: <%= ENV["SAML_IDP_METADATA_URL"].presence %>
  saml_idp_sso_service_url: <%= ENV["SAML_IDP_SSO_SERVICE_URL"].presence %>
  oidc_client_id: <%= ENV["OICD_CLIENT_ID"].presence %>
  oidc_client_secret: <%= ENV["OICD_CLIENT_SECRET"].presence %>
  oidc_issuer: <%= ENV["OICD_ISSUER"].presence %>
  contact_email: <%= ENV["CONTACT_EMAIL"].presence %>
  person_api_end_point: <%= ENV["PERSON_API_END_POINT"].presence %>
  <<: *maps
  <<: *apis
