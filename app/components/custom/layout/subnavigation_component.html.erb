
<nav class="<%= menu if menu %> small-12 medium-7 large-9 column float-right">
  <ul>
    <%= raw content_block("subnavigation_left") %>
    <% if feature?(:debates) %>
      <li class="debates <%= 'active' if controller_name == 'debates' %>">
        <%= link_to debates_path, class: "debates #{'active' if controller_name == 'debates'}", accesskey: "1" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.debates") %></h1>
        <% end %>
      </li>
    <% end %>

    <% if feature?(:proposals) %>
      <li class="proposals <%= 'active' if controller.class == ProposalsController %>">
        <%= link_to proposals_path, class: "proposals #{'active' if controller.class == ProposalsController}", accesskey: "2" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.proposals") %></h1>
        <% end %>
      </li>
    <% end %>

    <% if feature?(:polls) %>
      <li class="polls <%= 'active' if controller_name == 'polls' || (controller_name == 'questions' && controller.class.module_parent == Polls) %>">
        <%= link_to polls_path, class: "polls #{'active' if controller_name == 'polls' || (controller_name == 'questions' && controller.class.module_parent == Polls)}", accesskey: "3" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.poll_questions") %></h1>
        <% end %>
      </li>
    <% end %>

    <% if feature?(:legislation) %>
      <li class="collaborative_legislation <%= 'active' if controller.class.module_parent == Legislation %>">
        <%= link_to legislation_processes_path, class: "collaborative_legislation #{'active' if controller.class.module_parent == Legislation}", accesskey: "4" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.collaborative_legislation") %></h1>
        <% end %>
      </li>
    <% end %>

    <% if feature?(:budgets) %>
      <li class="budgets <%= 'active' if controller_name == 'budgets' || controller_name == 'investments' %>">
        <%= link_to budgets_path, class: "budgets #{'active' if controller_name == 'budgets' || controller_name == 'investments'}", accesskey: "5" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.budgets") %></h1>
        <% end %>
      </li>
    <% end %>

    <li class="mapa">
      <%= link_to "/mapa", class: "mapa  #{"active" if controller_name == "mapa"}", accesskey: "m"  do %>
        <h1 class="hide-for-small-only"> <%= t("layouts.header.mapa")%></h1>
      <% end %>
    </li>

    <li class="eventos">
      <%= link_to "/eventos", class: "eventos  #{"active" if controller_name == "eventos"}", accesskey: "m"  do %>
        <h1 class="hide-for-small-only"> <%= t("layouts.header.eventos")%></h1>
      <% end %>
    </li>


    <% if feature?(:sdg) %>
      <li class="sdg <%= 'active' if controller_path == 'sdg/goals' && action_name != 'help' %>">
        <%= link_to sdg_goals_path, class: "sdg #{'active' if controller_path == 'sdg/goals' && action_name != 'help'}", accesskey: "6" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.sdg") %></h1>
        <% end %>
      </li>
    <% end %>

    <% if feature?(:help_page) %>
      <li class="help <%= 'active' if current_page?(help_path) %>">
        <%= link_to help_path, class: "help #{'active' if current_page?(help_path)}", accesskey: "7" do %>
          <h1 class="hide-for-small-only"><%= t("layouts.header.help") %></h1>
        <% end %>
      </li>
    <% end %>
    <%= raw content_block("subnavigation_right") %>
  </ul>
</nav>



